guiTypes = {
	# BA_Precursor.0161 reward choice entry.
	containerWindowType = {
		name = "BA_Precursor_Reward_option"
		position = { x = 0 y = 0 }
		size = { width = 216 height = 62 }
		moveable = no

		buttonType = {
			name = "option_button"
			position = { x = 0 y = 0 }
			quadTextureSprite = "GFX_BA_Precursor_reward_option"
			font = "cg_16b"
			text = "OPTION_TEXT"
			clicksound = "confirm_click"
		}

		OverlappingElementsBoxType = {
			name = "trigger_icons"
			position = { x = 4 y = 12 }
			size = { x = 65 y = 28 }
		}

		OverlappingElementsBoxType = {
			name = "effect_icons"
			position = { x = 198 y = 12 }
			size = { x = 72 y = 28 }
			format = right
		}
	}

	# BA_Precursor.0161 reward selection window.
	containerWindowType = {
		name = "BA_Precursor_Reward_window"
		orientation = center
		origo = center
		position = { x = 0 y = 0 }
		size = { width = 1200 height = 650 }
		moveable = yes

		background = {
			name = "background"
			quadTextureSprite = "GFX_BA_Precursor_reward_frame"
			alwaysTransparent = yes
		}

		# Left-bottom dialogue panel.
		buttonType = {
			name = "alien_message_background"
			position = { x = 74 y = 448 }
			size = { x = 455 y = 159 }
			quadTextureSprite = "GFX_BA_Precursor_reward_dialog_background"
			alwaysTransparent = yes
		}

		instantTextBoxType = {
			name = "alien_message"
			font = "malgun_goth_24"
			position = { x = 94 y = 467 }
			maxWidth = 415
			maxHeight = 121
			format = left
			scrollbartype = "standardtext_slider"
		}

		# Event choices: 3 * 52 px buttons with 10 px vertical spacing.
		containerWindowType = {
			name = "EVENT_DIPLO"
			position = { x = 0 y = 0 }
			size = { width = 1200 height = 650 }
			moveable = no

			instantTextBoxType = {
				name = "action_title"
				font = "malgun_goth_24"
				position = { x = -10000 y = -10000 }
				maxWidth = 1
				maxHeight = 1
				alwaysTransparent = yes
			}

			instantTextBoxType = {
				name = "action_desc"
				font = "malgun_goth_24"
				position = { x = -10000 y = -10000 }
				maxWidth = 1
				maxHeight = 1
				alwaysTransparent = yes
			}

			listboxType = {
				name = "option_list"
				position = { x = 856 y = 214 }
				size = { x = 216 y = 186 }
				spacing = 0
				borderSize = { x = 0 y = 0 }
				orientation = UPPER_LEFT
			}
		}

		# Same close button used by BA_UI_Shittem.gui.
		buttonType = {
			name = "close"
			quadTextureSprite = "GFX_Mainpage_X"
			position = { x = -132 y = 30 }
			orientation = "UPPER_RIGHT"
			shortcut = "ESCAPE"
			clicksound = "back_click"
			actionShortcut = "cancel"
		}

		# Required diplomatic-event widgets that are not used by this layout.
		buttonType = {
			name = "focus_button"
			position = { x = -10000 y = -10000 }
			spriteType = "GFX_fleetview_focus"
			buttonFont = "cg_16b"
